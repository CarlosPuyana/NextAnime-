MAL_CLIENT_ID=
PORT=3000
CORS_ORIGINS=https://carlospuyana.github.io,http://127.0.0.1:5173,http://localhost:5173
VITE_API_URL=https://nextanime-server.up.railway.app
# Server only. Free-tier Gemini is not applicable to this EEA public deployment.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DEPLOYMENT_REGION=EEA
GEMINI_API_KEY=
GEMINI_KEY_ROTATED=false
GEMINI_FREE_TIER_VERIFIED=false
GEMINI_ADULT_AUDIENCE_APPROVED=false
# No new paid storage is created. Without durable quota storage Gemini stays off.
GEMINI_QUOTA_DB=
GEMINI_QUOTA_SECRET=
GEMINI_DAILY_LIMIT=10
GEMINI_PROFILE_DAILY_LIMIT=3
GEMINI_CLIENT_DAILY_LIMIT=3
GEMINI_RPM_LIMIT=2
GEMINI_DAILY_TOKEN_LIMIT=200000
GEMINI_MAX_CONCURRENT=1
GEMINI_TIMEOUT_MS=12000
