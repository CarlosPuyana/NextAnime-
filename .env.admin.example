# Private Railway variables. Never put these in VITE_ variables.
ADMIN_USERNAME=SadPuyana
# Generated by the local scripts/setup-admin.ts form; never a plaintext password.
ADMIN_PASSWORD_HASH=
# Cryptographically random secret, at least 32 characters; prepared in Railway.
ADMIN_SESSION_SECRET=
GEMINI_DAILY_LIMIT=6
GEMINI_PROFILE_DAILY_LIMIT=6
GEMINI_CLIENT_DAILY_LIMIT=6
GEMINI_DAILY_TOKEN_LIMIT=250000
GEMINI_MAX_CONCURRENT=1
GEMINI_ENABLED=false
GEMINI_PERSONAL_TEST_MODE=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=true
GROQ_TIMEOUT_MS=45000
GROQ_DAILY_LIMIT=6
GROQ_TPM_LIMIT=8000
# Operator checks are off during normal operation.
GROQ_CONNECTIVITY_CHECK=false
GROQ_RECOMMENDATION_CHECK=false
